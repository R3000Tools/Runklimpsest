// Runklimpsest audio engine - gen~ codebox (GenExpr).
// build_device.py embeds this file into [gen~ @ev ---rkev]; tests/audio_sim.js transpiles
// the same file to JavaScript and renders it, so the shipped code is the tested code.
// Keep to the subset the transpiler understands: one declaration per line, C-style
// statements, no user functions, locals assigned before use, loops "v += 1".
//
// Signal flow
//   input -> record (2 bars, "fresh" + "worn" copies) unless FREEZE
//   grain events (from the particle engine via buffer~ ---rkev) -> 32 voices
//   each voice reads "worn" (pitch = read speed, 0.3.0; reverse = read backwards),
//   outputs the grain and writes a degraded copy back
//   (palimpsest: reading wears the source), HEAL sweeps worn back toward fresh
//   grains: mono sum, constant-power pan from X (+-70 %) or centre (MONO)
//   wet: density normalisation, DC blocker -> equal-power MIX -> OUTPUT -> soft clip
//   display: overview of the buffer (256 columns) in buffer~ ---rkov, read by the jsui
// Latency: 0 samples (grains read from the past, dry is not delayed).

Param p_mix(50);
Param p_out(0);
Param p_size(30);
Param p_erosion(65);
Param p_weartype(0);
Param p_heal(40);
Param p_freeze(0);
Param p_stereo(0);
Param p_barsec(2);
Param p_evhead(0);
Buffer ev("rkev");
Buffer ov("rkov");
Data fresh(800000, 2);
Data worn(800000, 2);
Data vs(32, 21);
Data wdl(64, 2);
History wpos(0);
History healpos(0);
History lasthead(0);
History smix(0.5);
History sout(1);
History sload(1);
History dryms(0);
History wetms(0);
History agc(1);
History wdi(0);
History lenv(0);
History lgain(1);
History dcxl(0);
History dcyl(0);
History dcxr(0);
History dcyr(0);
History inpk(0);
History ovpos(0);
History ocol(0);
History afp(0);
History awp(0);
History aws(0);
History afs(0);
History ads(0);
History acnt(0);
History hcol(-1);
History hfp(0);
History hss(0);
History hn(0);

// ---------------------------------------------------------------- constants
cap = 800000;
blen = clamp(floor(p_barsec * 2 * samplerate), 4096, cap);
evslots = 64;
maxv = 32;

// ---------------------------------------------------------------- record
if (p_freeze < 0.5) {
	wi = wpos;
	if (wi >= blen) {
		wi = 0;
	}
	poke(fresh, in1, wi, 0);
	poke(fresh, in2, wi, 1);
	poke(worn, in1, wi, 0);
	poke(worn, in2, wi, 1);
	wpos = wi + 1;
	// display: the column under the write head is rebuilt live from the incoming audio
	// (0.2.8: the background scan alone took up to 1 s per pass - MEMORY built up in steps)
	wcol = floor(wi * 256 / blen);
	wm = (in1 + in2) * 0.5;
	if (wcol != hcol) {
		hfp = 0;
		hss = 0;
		hn = 0;
		hcol = wcol;
	}
	hfp = max(hfp, abs(wm));
	hss = hss + wm * wm;
	hn = hn + 1;
	poke(ov, hfp, wcol * 4, 0);
	poke(ov, hfp, wcol * 4 + 1, 0);
	poke(ov, sqrt(hss / hn), wcol * 4 + 2, 0);
	poke(ov, 0, wcol * 4 + 3, 0);
}

// ---------------------------------------------------------------- heal sweep
// one buffer position per sample; a full sweep takes blen samples, so the per-sweep
// pull toward "fresh" is 1 - exp(-sweep / HEAL) -> time constant = HEAL seconds
hi = healpos;
if (hi >= blen) {
	hi = 0;
}
hk = 1 - exp(-(blen / samplerate) / max(0.1, p_heal));
hfl = peek(fresh, hi, 0);
hfr = peek(fresh, hi, 1);
hwl = peek(worn, hi, 0);
hwr = peek(worn, hi, 1);
poke(worn, hwl + (hfl - hwl) * hk, hi, 0);
poke(worn, hwr + (hfr - hwr) * hk, hi, 1);
healpos = hi + 1;

// ---------------------------------------------------------------- display overview
// 256 columns x 4 values in buffer~ ---rkov (index col * 4 + k): fresh peak, worn peak,
// worn rms, wear (rms of worn - fresh relative to fresh rms, 0..1); index 1024 = write head
// position 0..1. Scans 4 buffer positions per sample: a 2-bar loop at 120 BPM in 1 s.
ovn = 256;
ovi = ovpos;
oc0 = ocol;
qfp = afp;
qwp = awp;
qws = aws;
qfs = afs;
qds = ads;
qn = acnt;
for (oqi = 0; oqi < 4; oqi += 1) {
	if (ovi >= blen) {
		ovi = 0;
	}
	ovc = floor(ovi * ovn / blen);
	if (ovc != oc0) {
		ocn = max(1, qn);
		ofr = sqrt(qfs / ocn);
		poke(ov, qfp, oc0 * 4, 0);
		poke(ov, qwp, oc0 * 4 + 1, 0);
		poke(ov, sqrt(qws / ocn), oc0 * 4 + 2, 0);
		poke(ov, clamp(sqrt(qds / ocn) / max(ofr, 0.003), 0, 1), oc0 * 4 + 3, 0);
		qfp = 0;
		qwp = 0;
		qws = 0;
		qfs = 0;
		qds = 0;
		qn = 0;
		oc0 = ovc;
	}
	ofm = (peek(fresh, ovi, 0) + peek(fresh, ovi, 1)) * 0.5;
	owm = (peek(worn, ovi, 0) + peek(worn, ovi, 1)) * 0.5;
	qfp = max(qfp, abs(ofm));
	qwp = max(qwp, abs(owm));
	qws = qws + owm * owm;
	qfs = qfs + ofm * ofm;
	qds = qds + (owm - ofm) * (owm - ofm);
	qn = qn + 1;
	ovi = ovi + 1;
}
ovpos = ovi;
ocol = oc0;
afp = qfp;
awp = qwp;
aws = qws;
afs = qfs;
ads = qds;
acnt = qn;
poke(ov, wpos / blen, ovn * 4, 0);

// ---------------------------------------------------------------- grain events
// slot k (1..63, 0) holds pos, amp, pan x, delay ms, pitch ratio, direction (+1/-1)
// at k*6 .. k*6+5 (0.3.0: 6 fields, was 4)
head = floor(p_evhead);
if (head != lasthead) {
	ek = lasthead;
	for (j = 0; j < evslots; j += 1) {
		if (ek != head) {
			ek = ek + 1;
			if (ek >= evslots) {
				ek = 0;
			}
			eb = ek * 6;
			epos = peek(ev, eb, 0);
			eamp = peek(ev, eb + 1, 0);
			ex = peek(ev, eb + 2, 0);
			edel = peek(ev, eb + 3, 0);
			erat = peek(ev, eb + 4, 0);
			if (erat <= 0) {
				erat = 1;
			}
			erat = clamp(erat, 0.25, 4);
			edir = 1;
			if (peek(ev, eb + 5, 0) < 0) {
				edir = -1;
			}
			// free voice first, else steal the one closest to its end
			best = 0;
			bestscore = -1;
			for (v = 0; v < maxv; v += 1) {
				vact = peek(vs, v, 0);
				vscore = 2;
				if (vact > 0.5) {
					vscore = peek(vs, v, 2) / max(1, peek(vs, v, 3));
				}
				if (vscore > bestscore) {
					bestscore = vscore;
					best = v;
				}
			}
			glen = max(48, floor(mstosamps(p_size * (1 + 0.08 * noise()))));
			// buffer span the audible grain reads (pitch = read speed) and the wear footprint:
			// at least 80 ms (0.2.6: 5 ms grains wore only 0.1 % of the loop per read)
			gspan = ceil(glen * erat) + 2;
			gwlen = max(gspan, floor(mstosamps(80)));
			gstart = floor(clamp(epos, 0, 1) * (blen - 1));
			// never read across the write head (newest meets oldest audio = click)
			if (p_freeze < 0.5) {
				gdist = wpos - gstart;
				if (gdist < 0) {
					gdist = gdist + blen;
				}
				if (edir > 0) {
					// forward: the whole footprint must lie behind the head - else start behind it
					if (gdist < gwlen + 64) {
						gstart = wpos - gwlen - 64;
					}
				} else {
					// reverse: reads toward older audio, where the advancing head overwrites;
					// keep footprint + head travel clear - else start right behind the head
					if (gdist < 2 || gdist > blen - gwlen - glen - 64) {
						gstart = wpos - 2;
					}
				}
				if (gstart < 0) {
					gstart = gstart + blen;
				}
			}
			gpan = 0;
			if (p_stereo < 0.5) {
				gpan = (clamp(ex, 0, 1) * 2 - 1) * 0.7;
			}
			gth = (gpan + 1) * pi * 0.25;
			poke(vs, 1, best, 0);
			poke(vs, floor(mstosamps(max(0, edel))), best, 1);
			poke(vs, 0, best, 2);
			poke(vs, glen, best, 3);
			poke(vs, gstart, best, 4);
			poke(vs, clamp(eamp, 0, 1), best, 5);
			poke(vs, cos(gth), best, 6);
			poke(vs, sin(gth), best, 7);
			poke(vs, 0, best, 8);
			poke(vs, 0, best, 9);
			poke(vs, 0, best, 10);
			poke(vs, 0, best, 11);
			poke(vs, 0, best, 12);
			poke(vs, 0, best, 13);
			poke(vs, gwlen, best, 14);
			// display: wear of the columns this voice wears (sum diff^2, sum fresh^2, count, column)
			poke(vs, 0, best, 15);
			poke(vs, 0, best, 16);
			poke(vs, 0, best, 17);
			poke(vs, -1, best, 18);
			// read speed (signed) for the audible grain, direction of the wear pass
			poke(vs, erat * edir, best, 19);
			poke(vs, edir, best, 20);
		}
	}
	lasthead = head;
}

// ---------------------------------------------------------------- voices
// erosion per read pass: EROSION^1.5 * 0.9 (0.3.0: DOSE removed - with TARGET WEAR it added up
// to +150 % within a few bars, so 0.2.9 measured EROSION^1.5 * 0.4 * ~2.2; the factor keeps the
// 0.2.9 wear level without DOSE).
// 0.2.2: 0.2.1 (EROSION^2 * 0.18, level-dependent targets) was inaudible on pads (user test);
// 0.2.9: EROSION^2 * 0.25 was barely audible on drums (live test 0.2.8) -> about 2x at 65 %,
// 3x at 30 %, 1.6x at 100 %
er = p_erosion * 0.01;
perread = min(0.9, pow(er, 1.5) * 0.9);
tapea = 1 - exp(-2 * pi * 2200 / samplerate);
wetl = 0;
wetr = 0;
nact = 0;
for (v = 0; v < maxv; v += 1) {
	if (peek(vs, v, 0) > 0.5) {
		vwait = peek(vs, v, 1);
		if (vwait > 0) {
			poke(vs, vwait - 1, v, 1);
		} else {
			vph = peek(vs, v, 2);
			vlen = peek(vs, v, 3);
			wlen = peek(vs, v, 14);
			vst = peek(vs, v, 4);
			// wear pass: one buffer sample per sample in the grain's direction (integer index)
			vidx = vst + vph * peek(vs, v, 20);
			if (vidx < 0) {
				vidx = vidx + blen;
			}
			if (vidx >= blen) {
				vidx = vidx - blen;
			}
			xl = peek(worn, vidx, 0);
			xr = peek(worn, vidx, 1);
			// audible part: Tukey window (25 % cosine flanks) over the grain length
			if (vph < vlen) {
				tt = vph / vlen;
				win = 1;
				if (tt < 0.25) {
					win = 0.5 - 0.5 * cos(pi * tt * 4);
				}
				if (tt > 0.75) {
					win = 0.5 - 0.5 * cos(pi * (1 - tt) * 4);
				}
				vg = peek(vs, v, 5) * win;
				// audible read at the grain's speed (pitch) and direction, linear interpolation
				grp = vst + vph * peek(vs, v, 19);
				if (grp < 0) {
					grp = grp + blen;
				}
				if (grp >= blen) {
					grp = grp - blen;
				}
				gri = floor(grp);
				grf = grp - gri;
				gri2 = gri + 1;
				if (gri2 >= blen) {
					gri2 = 0;
				}
				gal = peek(worn, gri, 0) + (peek(worn, gri2, 0) - peek(worn, gri, 0)) * grf;
				gar = peek(worn, gri, 1) + (peek(worn, gri2, 1) - peek(worn, gri, 1)) * grf;
				mono = (gal + gar) * 0.5 * vg;
				wetl = wetl + mono * peek(vs, v, 6);
				wetr = wetr + mono * peek(vs, v, 7);
				nact = nact + 1;
			}
			// wear window: same shape over the (longer) footprint
			tw = vph / wlen;
			winw = 1;
			if (tw < 0.25) {
				winw = 0.5 - 0.5 * cos(pi * tw * 4);
			}
			if (tw > 0.75) {
				winw = 0.5 - 0.5 * cos(pi * (1 - tw) * 4);
			}
			// palimpsest write-back: move the read samples toward a degraded version
			if (perread > 0) {
				// level-relative wear: every type works against the grain's own envelope, so it
				// is audible on quiet / dark material too (0.2.1 was level-dependent)
				venv = max(max(abs(xl), abs(xr)), peek(vs, v, 13) * 0.9997);
				poke(vs, venv, v, 13);
				ve = max(venv, 0.0001);
				dl = xl;
				dr = xr;
				if (p_weartype < 0.5) {
					// SAT: peak-preserving saturation (gain 1.3 for small signals, peaks kept);
					// repeated passes drift toward a fuzzy, square-ish tone
					dl = ve * tanh(1.2 * xl / ve) * 1.2008;
					dr = ve * tanh(1.2 * xr / ve) * 1.2008;
				} else {
					if (p_weartype < 1.5) {
						// TAPE: generation loss - lowpass ~2.2 kHz, unity-gain soft saturation, hiss -38 dB
						lpl = peek(vs, v, 8) + (xl - peek(vs, v, 8)) * tapea;
						lpr = peek(vs, v, 9) + (xr - peek(vs, v, 9)) * tapea;
						poke(vs, lpl, v, 8);
						poke(vs, lpr, v, 9);
						dl = ve * tanh(lpl / ve) + noise() * ve * 0.012;
						dr = ve * tanh(lpr / ve) + noise() * ve * 0.012;
					} else {
						// BIT: sample-and-hold (/5) + 3-bit quantisation relative to the envelope
						hc = peek(vs, v, 12);
						if (hc <= 0) {
							poke(vs, floor(xl / ve * 4 + 0.5) / 4 * ve, v, 10);
							poke(vs, floor(xr / ve * 4 + 0.5) / 4 * ve, v, 11);
							hc = 5;
						}
						poke(vs, hc - 1, v, 12);
						dl = peek(vs, v, 10);
						dr = peek(vs, v, 11);
					}
				}
				wk = perread * winw;
				nwl = xl + (dl - xl) * wk;
				nwr = xr + (dr - xr) * wk;
				poke(worn, nwl, vidx, 0);
				poke(worn, nwr, vidx, 1);
				// display: the worn columns update right away (0.2.8), the scan confirms later;
				// wear is scaled to the whole column (a voice may cover only part of it)
				vcol = floor(vidx * ovn / blen);
				if (vcol != peek(vs, v, 18)) {
					vcn = peek(vs, v, 17);
					if (vcn > 0) {
						vwear = clamp(sqrt(peek(vs, v, 15) / max(vcn, blen / ovn)) / max(sqrt(peek(vs, v, 16) / vcn), 0.003), 0, 1);
						vci = peek(vs, v, 18) * 4 + 3;
						poke(ov, max(peek(ov, vci, 0), vwear), vci, 0);
					}
					poke(vs, 0, v, 15);
					poke(vs, 0, v, 16);
					poke(vs, 0, v, 17);
					poke(vs, vcol, v, 18);
				}
				vfm = (peek(fresh, vidx, 0) + peek(fresh, vidx, 1)) * 0.5;
				vdm = (nwl + nwr) * 0.5 - vfm;
				poke(vs, peek(vs, v, 15) + vdm * vdm, v, 15);
				poke(vs, peek(vs, v, 16) + vfm * vfm, v, 16);
				poke(vs, peek(vs, v, 17) + 1, v, 17);
			}
			vph = vph + 1;
			poke(vs, vph, v, 2);
			if (vph >= wlen) {
				poke(vs, 0, v, 0);
				// last worn column of this voice into the display
				vcn = peek(vs, v, 17);
				if (vcn > 0) {
					vwear = clamp(sqrt(peek(vs, v, 15) / max(vcn, blen / ovn)) / max(sqrt(peek(vs, v, 16) / vcn), 0.003), 0, 1);
					vci = peek(vs, v, 18) * 4 + 3;
					poke(ov, max(peek(ov, vci, 0), vwear), vci, 0);
				}
			}
		}
	}
}

// ---------------------------------------------------------------- wet bus
// density normalisation: overlapping grains add up; scale by 1/sqrt(mean active voices),
// sqrt(2) undoes the -3 dB centre of the constant-power pan
sload = sload + (max(1, nact) - sload) * 0.0005;
wnorm = 1.4142 / sqrt(sload);
wetl = wetl * wnorm;
wetr = wetr * wnorm;
// automatic wet level: match the loudness of the input (mean square, ~0.4 s), gain limited
// (0.2.6: the wet level is measured only while grains sound - sparse short grains are
// matched as "each grain as loud as the input", pauses stay pauses; time-averaging left
// 5 ms grains 10 dB too quiet),
// to -12 .. +12 dB and smoothed (~0.3 s). Held while the input is silent, so a frozen loop
// keeps its level after the input stops (0.2.2: no longer held during FREEZE itself - TAPE
// wear made frozen loops 5 dB quieter).
// 0.2.9: the input mean square follows only while there is signal, and the regulation runs
// only while the input is active (peak > -60 dB, 0.2 s release). Before, the input mean fell
// in the silence and pulled the gain to its floor before the hold started: a frozen loop
// dropped ~20 dB after the input stopped (live test 0.2.8, reproduced in the simulation).
msc = 1 - exp(-1 / (0.4 * samplerate));
inms = (in1 * in1 + in2 * in2) * 0.5;
if (inms > 0.000001) {
	dryms = dryms + (inms - dryms) * msc;
}
inpk = max(max(abs(in1), abs(in2)), inpk * (1 - 1 / (0.2 * samplerate)));
if (nact > 0) {
	wetms = wetms + ((wetl * wetl + wetr * wetr) * 0.5 - wetms) * msc;
}
if (inpk > 0.001 && dryms > 0.000001 && wetms > 0.0000001) {
	agct = clamp(sqrt(dryms / wetms), 0.25, 4);
	agc = agc + (agct - agc) * (1 - exp(-1 / (0.3 * samplerate)));
}
wetl = wetl * agc;
wetr = wetr * agc;
// wet peak limiter, ceiling -2 dBFS, 64-sample lookahead (1.3 ms; the wet path is not
// time-aligned to the dry signal anyway, so this adds no latency to the device)
lpk = max(abs(wetl), abs(wetr));
if (lpk > lenv) {
	lenv = lpk;
} else {
	lenv = lenv + (lpk - lenv) * (1 - exp(-1 / (0.08 * samplerate)));
}
lgt = min(1, 0.79 / max(lenv, 0.000001));
if (lgt < lgain) {
	lgain = lgain + (lgt - lgain) * 0.06;
} else {
	lgain = lgain + (lgt - lgain) * (1 - exp(-1 / (0.08 * samplerate)));
}
wdo = wdi + 1;
if (wdo >= 64) {
	wdo = 0;
}
poke(wdl, wetl, wdi, 0);
poke(wdl, wetr, wdi, 1);
wetl = peek(wdl, wdo, 0) * lgain;
wetr = peek(wdl, wdo, 1) * lgain;
wdi = wdo;
// DC blocker (~10 Hz): repeated asymmetric wear must not leave an offset
dcol = wetl - dcxl + 0.9987 * dcyl;
dcxl = wetl;
dcyl = dcol;
dcor = wetr - dcxr + 0.9987 * dcyr;
dcxr = wetr;
dcyr = dcor;

// ---------------------------------------------------------------- mix, output
smix = smix + (clamp(p_mix * 0.01, 0, 1) - smix) * 0.0008;
sout = sout + (pow(10, clamp(p_out, -24, 12) / 20) - sout) * 0.0008;
dryg = cos(smix * pi * 0.5);
wetg = sin(smix * pi * 0.5);
ol = (in1 * dryg + dcol * wetg) * sout;
orr = (in2 * dryg + dcor * wetg) * sout;
// transparent below -0.9 dBFS, soft knee above (protection, not a sound feature)
al = abs(ol);
if (al > 0.9) {
	ol = sign(ol) * (0.9 + 0.1 * tanh((al - 0.9) * 10));
}
ar = abs(orr);
if (ar > 0.9) {
	orr = sign(orr) * (0.9 + 0.1 * tanh((ar - 0.9) * 10));
}
out1 = ol;
out2 = orr;
